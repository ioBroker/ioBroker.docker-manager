{
  "name": "iobroker.docker-manager",
  "version": "1.0.1",
  "description": "Pull, delete, start, stop and manage Docker containers directly from ioBroker",
  "author": {
    "name": "Denis Haev",
    "email": "dogafox@gmail.com"
  },
  "contributors": [],
  "homepage": "https://github.com/ioBroker/ioBroker.docker-manager",
  "keywords": [
    "ioBroker",
    "docker",
    "manager"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.docker-manager"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/plugin-docker": "^1.0.4",
    "axios": "^1.19.0",
    "dockerode": "^5.0.1",
    "range_check": "^4.1.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/build-tools": "^3.0.1",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/legacy-testing": "^3.0.0",
    "@iobroker/testing": "^5.3.0",
    "@iobroker/types": "^7.2.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.1.2",
    "@types/tar-fs": "^2.0.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.docker-manager/issues"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "io-package.json",
    "LICENSE",
    "build/"
  ],
  "scripts": {
    "test:integration": "mocha --exit",
    "test:package": "mocha test/package.test.js --exit",
    "test": "npm run test:integration",
    "prepublishOnly": "npm run build",
    "npm": "npm i && cd src-admin && npm i",
    "lint": "eslint -c eslint.config.mjs",
    "lint-frontend": "cd src-admin && eslint -c eslint.config.mjs",
    "build": "npm run build:ts && npm run build:gui",
    "build:gui": "tsx tasks.ts --build",
    "build:ts": "tsc -p tsconfig.build.json && tsx tasks.ts --copy-i18n",
    "build:pack": "npm run build:ts && npm pack",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-admin && npx -y npm-check-updates --upgrade",
    "0-clean": "tsx tasks.ts --0-clean",
    "1-npm": "tsx tasks.ts --1-npm",
    "2-build": "tsx tasks.ts --2-build",
    "3-copy": "tsx tasks.ts --3-copy",
    "4-patch": "tsx tasks.ts --4-patch"
  },
  "license": "MIT",
  "readmeFilename": "README.md"
}
